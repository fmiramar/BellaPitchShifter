examples::

code::
(
s.waitForBoot {
	Routine {
		var srcbuf = Buffer.read(s, ExampleFiles.child);
		s.sync;
		{
			var src = PlayBuf.ar(1, srcbuf, BufRateScale.kr(srcbuf), loop: 1);
			// For live input instead:
			// src = SoundIn.ar(0);
			var chain = FFT(LocalBuf(2048), src, hop: 0.125, wintype: 1);
			var fade = Line.kr(0, 1, 0.1);
			chain = PV_PitchShiftBella(chain, 2 ** (7 / 12));
			(IFFT.ar(chain, wintype: 1) * fade * 0.15) ! 2
		}.play
	}.play;
}
)
::

code::
// Continue processing the shifted spectrum before returning to audio.
(
s.waitForBoot {
	Routine {
		var srcbuf = Buffer.read(s, ExampleFiles.child);
		s.sync;
		{
			var src = PlayBuf.ar(1, srcbuf, BufRateScale.kr(srcbuf), loop: 1);
			// For live input instead:
			// src = SoundIn.ar(0);
			var chain = FFT(LocalBuf(2048), src, hop: 0.125, wintype: 1);
			var fade = Line.kr(0, 1, 0.1);
			chain = PV_PitchShiftBella(chain, MouseX.kr(0.5, 2.0, \exponential));
			chain = PV_MagSmear(chain, MouseY.kr(0, 12));
			(IFFT.ar(chain, wintype: 1) * fade * 0.15) ! 2
		}.play
	}.play;
}
)
::

subsection:: Source

Andrew McPherson, "Phase Vocoder Part 3", C++ for Real-Time Audio Programming with Bela. link::https://learn.bela.io/tutorials/c-plus-plus-for-real-time-audio-programming/phase-vocoder-part-3/::
